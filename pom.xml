<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.zjc</groupId>
    <artifactId>spring-cloud-alibaba</artifactId>
    <version>1.0.0</version>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
    </parent>

    <packaging>pom</packaging>

    <name>Spring Cloud Alibaba Parent</name>
    <description>Spring Cloud Alibaba 微服务父项目</description>

    <modules>
        <module>service-common</module>
        <module>service-provider</module>
        <module>service-consumer</module>
        <module>service-gateway</module>
        <module>service-mail</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 核心框架版本 -->
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>
        <!-- Jackson 2 兼容链安全版本覆盖 -->
        <jackson-2-bom.version>2.21.5</jackson-2-bom.version>
        <!-- Jackson 3 安全版本覆盖 -->
        <jackson-bom.version>3.1.5</jackson-bom.version>
        <!-- Netty 安全版本覆盖 -->
        <netty.version>4.2.17.Final</netty.version>
        <!-- Apache HttpCore 5 安全版本覆盖 -->
        <httpcore5.version>5.4.3</httpcore5.version>
        <!-- Apache HttpClient 5 安全版本覆盖 -->
        <httpclient5.version>5.6.3</httpclient5.version>
        <!-- Log4j 2 API 安全版本覆盖 -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- 其他依赖 -->
        <hutool.version>5.8.47</hutool.version>
        <bouncycastle.version>1.85.2</bouncycastle.version>
        <mybatis.plus.version>3.5.17</mybatis.plus.version>
        <swagger.version>2.2.54</swagger.version>
        <springdoc.version>3.1.0</springdoc.version>
        <jasypt-spring-boot.version>4.0.4</jasypt-spring-boot.version>
        <jasypt.version>1.9.3</jasypt.version>
        <!-- Redisson：延迟队列、可重入锁、看门狗、分布式限流 -->
        <redisson.version>4.7.0</redisson.version>
        <!-- JaCoCo 版本（支持 Java 21 字节码） -->
        <jacoco.version>0.8.15</jacoco.version>

        <!-- MapStruct（编译期 DTO <-> Entity 转换，零反射） -->
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Docker 镜像构建：Jib 版本 -->
        <jib-maven-plugin.version>3.5.2</jib-maven-plugin.version>
        <!-- 本地镜像名：zjc/<module>:tag -->
        <docker.image-prefix>zjc</docker.image-prefix>
        <!-- 可通过 -Ddocker.tag=... 覆盖，默认使用工程版本 -->
        <docker.tag>${project.version}</docker.tag>
        <!-- 构建时基础镜像；Docker Hub 直连不稳定时可用 -Ddocker.base-image=... 替换 -->
        <docker.base-image>dockerproxy.net/library/eclipse-temurin:21-jre</docker.base-image>
        <!-- 可运行模块在 docker-tar Profile 中覆盖为 false；common 和父 POM 不生成镜像 -->
        <jib.skip>true</jib.skip>

    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud 依赖管理（BOM） -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Spring Cloud Alibaba 依赖管理（BOM） -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 糊涂工具类（Hutool） -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- Bouncy Castle 加密库（修复 CVE-2026-0636） -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>

            <!-- MyBatis-Plus Spring Boot 4 Starter -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>

            <!-- MyBatis-Plus 分页插件（JSqlParser） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis.plus.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI（Swagger UI） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- SpringDoc OpenAPI（Gateway WebFlux Swagger UI 聚合） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- SpringDoc 公共模型（service-common 只依赖 API，不携带 Swagger UI） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Swagger 注解（供 common 模块 DTO 字段文档描述使用） -->
            <dependency>
                <groupId>io.swagger.core.v3</groupId>
                <artifactId>swagger-annotations-jakarta</artifactId>
                <version>${swagger.version}</version>
            </dependency>

            <!-- Spring Boot 配置元数据处理器（@ConfigurationProperties 自动补全） -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-configuration-processor</artifactId>
                <version>${spring-boot.version}</version>
            </dependency>

            <!-- Jasypt 配置加密 -->
            <dependency>
                <groupId>com.github.ulisesbocchio</groupId>
                <artifactId>jasypt-spring-boot-starter</artifactId>
                <version>${jasypt-spring-boot.version}</version>
            </dependency>

            <!-- Jasypt 加密核心（service-common 测试工具显式使用） -->
            <dependency>
                <groupId>org.jasypt</groupId>
                <artifactId>jasypt</artifactId>
                <version>${jasypt.version}</version>
            </dependency>

            <!-- Redisson Core：由业务模块自行装配，避免 starter 绑定 Spring Boot 自动配置 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>


            <!-- MapStruct（编译期 Bean 映射，替代 BeanUtils.copyProperties） -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    Jib 公共配置：可运行服务通过 docker-tar Profile 激活。
                    buildTar 不依赖本机 Docker daemon，产物是 target/jib-image.tar。
                -->
                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>${jib-maven-plugin.version}</version>
                    <configuration>
                        <!-- 父 POM 和依赖模块默认跳过，只有可运行服务的 docker-tar Profile 打开开关 -->
                        <skip>${jib.skip}</skip>
                        <from>
                            <!-- 基础镜像只提供 JRE；平台固定为 VMware Ubuntu 常见的 linux/amd64 -->
                            <image>${docker.base-image}</image>
                            <platforms>
                                <platform>
                                    <os>linux</os>
                                    <architecture>amd64</architecture>
                                </platform>
                            </platforms>
                        </from>
                        <to>
                            <!-- 镜像名中的 artifactId 对应各服务模块，不含 service-common -->
                            <image>${docker.image-prefix}/${project.artifactId}:${docker.tag}</image>
                        </to>
                        <container>
                            <!-- 启动类和端口由各可运行模块在 docker-tar Profile 中提供 -->
                            <mainClass>${docker.main-class}</mainClass>
                            <!-- Logback 使用相对路径 logs/...，工作目录固定后日志落在 /app/logs/... -->
                            <workingDirectory>/app</workingDirectory>
                            <jvmFlags>
                                <jvmFlag>-Duser.timezone=Asia/Shanghai</jvmFlag>
                                <jvmFlag>-Dfile.encoding=UTF-8</jvmFlag>
                                <!-- 追加外置配置目录；optional 保证未挂载时仍使用镜像内置配置 -->
                                <jvmFlag>-Dspring.config.additional-location=optional:file:/app/config/</jvmFlag>
                                <!-- 按容器内存限制计算堆，便于在 Compose 中统一调优 -->
                                <jvmFlag>-XX:MaxRAMPercentage=75.0</jvmFlag>
                                <!-- OOM 时退出进程，交给 Docker 重启策略拉起新实例 -->
                                <jvmFlag>-XX:+ExitOnOutOfMemoryError</jvmFlag>
                                <!-- 保留 OOM 现场，默认输出到进程工作目录 -->
                                <jvmFlag>-XX:+HeapDumpOnOutOfMemoryError</jvmFlag>
                            </jvmFlags>
                            <!-- 仅是镜像元数据声明，不限制运行时映射到宿主机的端口 -->
                            <ports>
                                <port>${docker.container-port}</port>
                            </ports>
                        </container>
                    </configuration>
                </plugin>

                <!-- 编译插件 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>0.2.0</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>

    <!-- 所有子模块自动继承以下插件 -->
    <plugins>
        <!-- Jib：由各可运行模块的 docker-tar Profile 覆盖 jib.skip 后生成镜像 tar -->
        <plugin>
            <groupId>com.google.cloud.tools</groupId>
            <artifactId>jib-maven-plugin</artifactId>
            <executions>
                <execution>
                    <id>build-docker-tar</id>
                    <phase>package</phase>
                    <goals>
                        <goal>buildTar</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>

        <!-- JaCoCo：运行 mvn test 时生成覆盖率报告 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Surefire：消除 JDK 21+ 动态 Agent 加载警告（Mockito/ByteBuddy） -->
            <!-- @{argLine} 晚绑定保留 JaCoCo 注入的 agent 路径 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                </configuration>
            </plugin>

            <!-- Spring Boot 打包：生成包含全部运行依赖的可执行 Fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
